generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum UserRole {
  super_admin
  admin
  teacher
  student
  parent
  department_head
  accountant
}

enum ExamStatus {
  draft
  scheduled
  ongoing
  completed
  cancelled
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum AnnouncementStatus {
  draft
  scheduled
  published
  expired
  archived
  cancelled
}

enum AnnouncementPriority {
  normal
  important
  urgent
}

enum AnnouncementAudienceType {
  all_users
  role
  class
  section
}

enum AnnouncementAuditAction {
  created
  updated
  scheduled
  published
  cancelled
  archived
  expired
}

model School {
  id                        String                     @id @default(uuid()) @db.Uuid
  name                      String
  slug                      String?                    @unique
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  users                     User[]
  classes                   Class[]
  legacyClasses             LegacyClass[]
  academicYears             AcademicYear[]
  sections                  Section[]
  enrollments               Enrollment[]
  teacherProfiles           TeacherProfile[]
  departments               Department[]
  subjects                  Subject[]
  parentStudentLinks        ParentStudent[]
  subjectClassLinks         SubjectClass[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  exams                     Exam[]
  attendanceSessions        AttendanceSession[]
  attendanceRecords         AttendanceRecord[]
  feeCategories             FeeCategory[]
  feeStructures            FeeStructure[]
  studentFeeAssignments     StudentFeeAssignment[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  payments                 Payment[]
  suppliers                Supplier[]
  expenseCategories        ExpenseCategory[]
  expenses                 Expense[]
  expenseItems             ExpenseItem[]
  refunds                  Refund[]
  financialAdjustments     FinancialAdjustment[]
  accountingSettings      AccountingSettings?
  fiscalYears              FiscalYear[]
  accountingPeriods       AccountingPeriod[]
  chartOfAccounts         ChartOfAccount[]
  journalEntries          JournalEntry[]
  journalLines            JournalLine[]
  paymentAllocations      PaymentAllocation[]
  expensePayments         ExpensePayment[]
  messages                 Message[]
  messageRecipients        MessageRecipient[]
  announcements            Announcement[]
  announcementRecipients   AnnouncementRecipient[]
  announcementAuditEvents  AnnouncementAuditEvent[]

  @@index([isActive])
  @@map("schools")
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  schoolId            String?         @db.Uuid
  firstName           String
  lastName            String
  email               String          @unique
  passwordHash        String
  role                UserRole
  phone               String?
  isActive            Boolean         @default(true)
  isEmailVerified     Boolean         @default(false)
  lastLogin           DateTime?
  passwordChangedAt   DateTime?
  refreshTokenVersion Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  school              School?         @relation(fields: [schoolId], references: [id])
  teacherProfile      TeacherProfile?
  studentProfile      StudentProfile?
  parentStudentLinks          ParentStudent[]         @relation("ParentStudentParent")
  homeroomClasses             LegacyClass[]           @relation("HomeroomTeacher")
  sectionHomerooms            Section[]               @relation("SectionHomeroomTeacher")
  departmentHeads            Department[]            @relation("DepartmentHead")
  attendanceSessions          AttendanceSession[]     @relation("AttendanceSessionTeacher")
  invoiceCreatedBy            Invoice[]               @relation("InvoiceCreatedBy")
  invoiceApprovedBy           Invoice[]               @relation("InvoiceApprovedBy")
  paymentRecordedBy           Payment[]               @relation("PaymentRecordedBy")
  paymentApprovedBy           Payment[]               @relation("PaymentApprovedBy")
  paymentAllocationsCreated  PaymentAllocation[]     @relation("PaymentAllocationCreatedBy")
  expenseCreatedBy            Expense[]               @relation("ExpenseCreatedBy")
  expenseApprovedBy           Expense[]               @relation("ExpenseApprovedBy")
  expensePaymentRecordedBy    ExpensePayment[]        @relation("ExpensePaymentRecordedBy")
  refundApprovedBy            Refund[]                @relation("RefundApprovedBy")
  adjustmentCreatedBy         FinancialAdjustment[]   @relation("FinancialAdjustmentCreatedBy")
  adjustmentApprovedBy        FinancialAdjustment[]   @relation("FinancialAdjustmentApprovedBy")
  fiscalYearsClosed           FiscalYear[]            @relation("FiscalYearClosedBy")
  accountingPeriodsClosed     AccountingPeriod[]      @relation("AccountingPeriodClosedBy")
  journalEntriesCreated       JournalEntry[]           @relation("JournalEntryCreatedBy")
  journalEntriesPosted        JournalEntry[]           @relation("JournalEntryPostedBy")
  sentMessages                Message[]                @relation("MessageSender")
  messageRecipients           MessageRecipient[]       @relation("MessageRecipientUser")
  authoredAnnouncements       Announcement[]           @relation("AnnouncementAuthor")
  announcementRecipients      AnnouncementRecipient[]  @relation("AnnouncementRecipientUser")
  announcementAuditEvents     AnnouncementAuditEvent[] @relation("AnnouncementAuditActor")

  @@index([schoolId])
  @@index([schoolId, role])
  @@index([schoolId, role, createdAt])
  @@index([role])
  @@index([createdAt])
  @@index([role], map: "idx_users_role")
  @@index([schoolId], map: "idx_users_school_id")
  @@index([firstName(ops: raw("gin_trgm_ops"))], map: "users_first_name_trgm_idx", type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], map: "users_last_name_trgm_idx", type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], map: "users_email_trgm_idx", type: Gin)
  @@map("users")
}

model TeacherProfile {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @unique @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  departmentId   String?     @db.Uuid
  department     Department? @relation("DepartmentTeacherProfiles", fields: [departmentId], references: [id], onDelete: SetNull)
  hireDate       DateTime?
  qualifications String?
  employeeId     String?

  subjectTeacherAssignments SubjectTeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, employeeId])
  @@index([schoolId])
  @@index([employeeId(ops: raw("gin_trgm_ops"))], map: "teacher_profiles_employee_trgm_idx", type: Gin)
  @@map("teacher_profiles")
}

model Department {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String
  code        String
  description String?
  icon        String?
  isActive    Boolean @default(true)

  headTeacherId String? @db.Uuid
  headTeacher   User?   @relation("DepartmentHead", fields: [headTeacherId], references: [id], onDelete: SetNull)

  teacherProfiles TeacherProfile[] @relation("DepartmentTeacherProfiles")
  subjects        Subject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("departments")
}

model StudentProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  admissionNo    String?   @unique
  dateOfBirth    DateTime?
  gender         String?
  enrollmentDate DateTime?

  classId String?      @db.Uuid
  class   LegacyClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  previousSchool String?
  medicalNotes   String?
  address        String?
  guardianName   String?
  guardianPhone  String?
  guardianEmail  String?

  parentLinks ParentStudent[]
  enrollments Enrollment[]
  attendanceRecords AttendanceRecord[]
  studentFeeAssignments StudentFeeAssignment[]
  invoices Invoice[]
  payments Payment[]
  journalLines JournalLine[]
  financialAdjustments FinancialAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([admissionNo(ops: raw("gin_trgm_ops"))], map: "student_profiles_admission_trgm_idx", type: Gin)
  @@map("student_profiles")
}

model ParentStudent {
  schoolId         String         @db.Uuid
  parentId         String         @db.Uuid
  studentProfileId String         @db.Uuid
  relationship     String         @default("guardian")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent           User           @relation("ParentStudentParent", fields: [parentId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@id([schoolId, parentId, studentProfileId])
  @@index([schoolId, parentId])
  @@index([schoolId, studentProfileId])
  @@map("parent_students")
}

model LegacyClass {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name         String // "Grade 10A"
  grade        String // "10"
  section      String // "A"
  academicYear String // "2026-2027"
  capacity     Int? // optional max students

  homeroomTeacherId String? @db.Uuid
  homeroomTeacher   User?   @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)

  students                  StudentProfile[]
  subjectLinks              SubjectClass[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  sectionRecord             Section?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, grade, section, academicYear])
  @@index([schoolId])
  @@index([homeroomTeacherId])
  @@map("classes")
}

model Class {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @db.Uuid
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  grade       String
  description String?
  isActive    Boolean   @default(true)
  sections    Section[]
  feeStructures FeeStructure[]
  announcementAudienceRules AnnouncementAudienceRule[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([schoolId, code])
  @@unique([schoolId, grade])
  @@index([schoolId, isActive])
  @@map("school_classes")
}

model AcademicYear {
  id          String       @id @default(uuid()) @db.Uuid
  schoolId    String       @db.Uuid
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  isCurrent   Boolean      @default(false)
  isActive    Boolean      @default(true)
  sections    Section[]
  enrollments Enrollment[]
  exams       Exam[]
  attendanceSessions AttendanceSession[]
  feeStructures FeeStructure[]
  studentFeeAssignments StudentFeeAssignment[]
  invoices Invoice[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("academic_years")
}

model Section {
  id                String       @id @default(uuid()) @db.Uuid
  schoolId          String       @db.Uuid
  school            School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId           String       @db.Uuid
  class             Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  name              String
  code              String
  academicYearId    String       @db.Uuid
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  capacity          Int?
  room              String?
  isActive          Boolean      @default(true)
  homeroomTeacherId String?      @db.Uuid
  homeroomTeacher   User?        @relation("SectionHomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  legacyClassId     String?      @unique @db.Uuid
  legacyClass       LegacyClass? @relation(fields: [legacyClassId], references: [id], onDelete: SetNull)
  enrollments       Enrollment[]
  exams             Exam[]
  attendanceSessions AttendanceSession[]
  announcementAudienceRules AnnouncementAudienceRule[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([schoolId, classId, academicYearId, name])
  @@unique([schoolId, classId, academicYearId, code])
  @@index([schoolId, academicYearId, isActive])
  @@index([classId, academicYearId])
  @@index([homeroomTeacherId])
  @@map("sections")
}

model AttendanceSession {
  id             String            @id @default(uuid()) @db.Uuid
  schoolId       String            @db.Uuid
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String            @db.Uuid
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sectionId      String            @db.Uuid
  section        Section           @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subjectId      String?           @db.Uuid
  subject        Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId      String?           @db.Uuid
  teacher        User?             @relation("AttendanceSessionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  attendanceDate DateTime          @db.Date
  type           String            @default("daily")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  records        AttendanceRecord[]

  @@unique([schoolId, sectionId, academicYearId, attendanceDate, type], map: "attendance_sessions_dedupe_key")
  @@index([schoolId, attendanceDate])
  @@index([schoolId, sectionId, attendanceDate])
  @@index([schoolId, academicYearId, attendanceDate])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id               String            @id @default(uuid()) @db.Uuid
  schoolId         String            @db.Uuid
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessionId        String            @db.Uuid
  session          AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentProfileId String            @db.Uuid
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  status           AttendanceStatus
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([sessionId, studentProfileId], map: "attendance_records_session_student_key")
  @@index([schoolId, sessionId])
  @@index([schoolId, studentProfileId])
  @@index([status])
  @@map("attendance_records")
}

model Enrollment {
  id               String         @id @default(uuid()) @db.Uuid
  schoolId         String         @db.Uuid
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfileId String         @db.Uuid
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  sectionId        String         @db.Uuid
  section          Section        @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  academicYearId   String         @db.Uuid
  academicYear     AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  isActive         Boolean        @default(true)
  enrolledAt       DateTime       @default(now())
  endedAt          DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([schoolId, studentProfileId, sectionId, academicYearId])
  @@index([schoolId, sectionId, academicYearId, isActive])
  @@index([studentProfileId, academicYearId])
  @@map("enrollments")
}

model Subject {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  name         String
  code         String
  description  String?
  academicYear String?
  isActive     Boolean @default(true)

  classLinks         SubjectClass[]
  teacherAssignments SubjectTeacherAssignment[]
  exams              Exam[]
  attendanceSessions AttendanceSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("subjects")
}

model Exam {
  id             String     @id @default(uuid()) @db.Uuid
  schoolId       String     @db.Uuid
  academicYearId String     @db.Uuid
  sectionId      String     @db.Uuid
  subjectId      String     @db.Uuid
  name           String
  description    String?
  type           String
  term           String?
  examDate       DateTime   @db.Date
  startTime      String?    @db.VarChar(5)
  endTime        String?    @db.VarChar(5)
  durationMinutes Int?
  totalMarks     Decimal    @db.Decimal(8, 2)
  passingMarks   Decimal    @db.Decimal(8, 2)
  status         ExamStatus @default(draft)
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([schoolId, academicYearId, sectionId, subjectId, name, examDate], map: "exams_dedupe_key")
  @@index([schoolId, academicYearId, status, archivedAt])
  @@index([schoolId, sectionId, examDate])
  @@index([schoolId, subjectId, examDate])
  @@index([schoolId, examDate])
  @@map("exams")
}

model SubjectClass {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  subjectId    String   @db.Uuid
  classId      String   @db.Uuid
  academicYear String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   LegacyClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([subjectId, classId, academicYear])
  @@index([schoolId, subjectId])
  @@index([schoolId, classId])
  @@map("subject_classes")
}

model SubjectTeacherAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @db.Uuid
  teacherProfileId String   @db.Uuid
  subjectId        String   @db.Uuid
  classId          String?  @db.Uuid
  academicYear     String?
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class          LegacyClass?   @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([schoolId, teacherProfileId, subjectId, classId, academicYear])
  @@index([schoolId, subjectId])
  @@index([schoolId, teacherProfileId])
  @@map("subject_teacher_assignments")
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  voided
  cancelled
}

enum PaymentStatus {
  pending
  processing
  successful
  failed
  refunded
  reversed
  cancelled
}

enum PaymentMethod {
  cash
  bank_transfer
  mobile_money
  cheque
  card
  other
}

enum ExpenseStatus {
  draft
  approved
  pending_payment
  partially_paid
  paid
  overdue
  cancelled
  voided
}

enum FinancialAdjustmentType {
  discount
  waiver
  correction
  charge
  penalty
  other
}

enum AdjustmentStatus {
  draft
  pending
  approved
  rejected
  cancelled
}

enum AccountingMethod {
  accrual
  cash
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  debit
  credit
}

enum FiscalPeriodStatus {
  open
  closed
}

enum EntryStatus {
  draft
  posted
  reversed
}

enum RefundStatus {
  pending
  approved
  processed
  failed
  cancelled
}

model FeeCategory {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  description String?
  code        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]
  invoiceItems  InvoiceItem[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("fee_categories")
}

model FeeStructure {
  id               String    @id @default(uuid()) @db.Uuid
  schoolId         String    @db.Uuid
  feeCategoryId    String    @db.Uuid
  academicYearId   String?   @db.Uuid
  classId          String?   @db.Uuid
  name             String
  amount           Decimal   @db.Decimal(12, 2)
  billingFrequency String?
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  isMandatory      Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeCategory       FeeCategory         @relation(fields: [feeCategoryId], references: [id], onDelete: Restrict)
  academicYear      AcademicYear?       @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  class             Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  studentAssignments StudentFeeAssignment[]
  invoiceItems      InvoiceItem[]

  @@index([schoolId, isActive])
  @@index([schoolId, feeCategoryId])
  @@index([academicYearId])
  @@map("fee_structures")
}

model StudentFeeAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  schoolId         String    @db.Uuid
  studentProfileId String    @db.Uuid
  feeStructureId   String    @db.Uuid
  academicYearId   String    @db.Uuid
  assignedAmount   Decimal   @db.Decimal(12, 2)
  adjustmentAmount Decimal   @db.Decimal(12, 2) @default(0)
  assignmentDate   DateTime  @default(now())
  status           String    @default("active")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  feeStructure   FeeStructure   @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@index([schoolId, studentProfileId])
  @@index([schoolId, academicYearId])
  @@map("student_fee_assignments")
}

model Invoice {
  id               String       @id @default(uuid()) @db.Uuid
  schoolId         String       @db.Uuid
  studentProfileId String       @db.Uuid
  academicYearId   String?      @db.Uuid
  invoiceNumber    String
  issueDate        DateTime     @db.Date
  dueDate          DateTime     @db.Date
  currency         String       @db.VarChar(3)
  subtotal         Decimal      @db.Decimal(12, 2)
  discountAmount   Decimal      @db.Decimal(12, 2) @default(0)
  adjustmentAmount Decimal      @db.Decimal(12, 2) @default(0)
  totalAmount      Decimal      @db.Decimal(12, 2)
  status           InvoiceStatus @default(draft)
  createdById      String?      @db.Uuid
  approvedById     String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?          @relation("InvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  allocations    PaymentAllocation[]
  journalLines   JournalLine[]
  adjustments    FinancialAdjustment[]

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId, studentProfileId])
  @@index([schoolId, status, dueDate])
  @@index([schoolId, issueDate])
  @@map("invoices")
}

model InvoiceItem {
