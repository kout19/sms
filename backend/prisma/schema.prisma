generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  super_admin
  admin
  teacher
  student
  parent
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([isActive])
  @@map("schools")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  schoolId            String?   @db.Uuid
  firstName           String
  lastName            String
  email               String    @unique
  passwordHash        String
  role                UserRole
  phone               String?
  isActive            Boolean   @default(true)
  isEmailVerified     Boolean   @default(false)
  lastLogin           DateTime?
  passwordChangedAt   DateTime?
  refreshTokenVersion Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([schoolId, role])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}
