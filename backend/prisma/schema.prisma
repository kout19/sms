/// Internal school messaging.
/// A Message is a single email-like unit authored by one sender. When it is
/// addressed to several users, one MessageRecipient row is created per
/// recipient so read/archive/trash state is independent per recipient.
/// Replies are modeled as a Message whose `parentMessageId` points at the
/// message being replied to, giving a conversation/thread structure without
/// duplicating standalone messages.
model Message {
  id              String   @id @default(uuid()) @db.Uuid
  schoolId        String   @db.Uuid
  senderId        String   @db.Uuid
  subject         String   @db.VarChar(200)
  body            String
  // Optional previous message this one replies to (threading).
  parentMessageId String?  @db.Uuid
  // Soft-delete marker for the sender's own view (does not affect recipients).
  deletedBySender Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school        School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender        User               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  parentMessage Message?           @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies       Message[]          @relation("MessageThread")
  recipients    MessageRecipient[]

  @@index([schoolId, senderId, createdAt])
  @@index([schoolId, createdAt])
  @@index([parentMessageId])
  @@map("messages")
}

/// One row per (message, recipient). Holds recipient-specific state so that
/// each recipient has an independent read/unread, archive and trash state.
model MessageRecipient {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @db.Uuid
  recipientId String    @db.Uuid
  schoolId    String    @db.Uuid
  isRead      Boolean   @default(false)
  readAt      DateTime?
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient User    @relation("MessageRecipientUser", fields: [recipientId], references: [id], onDelete: Cascade)
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientId], map: "message_recipients_message_recipient_key")
  @@index([schoolId, recipientId, isDeleted, isArchived], map: "message_recipients_inbox_idx")
  @@index([schoolId, recipientId, isRead], map: "message_recipients_unread_idx")
  @@index([messageId], map: "message_recipients_message_idx")
  @@map("message_recipients")
}

/// School-wide broadcast content. Audience rules describe intended targets;
/// recipients are materialized only when the announcement is published.
model Announcement {
  id           String               @id @default(uuid()) @db.Uuid
  schoolId     String               @db.Uuid
  authorId     String               @db.Uuid
  title        String               @db.VarChar(200)
  content      String
  priority     AnnouncementPriority @default(normal)
  status       AnnouncementStatus   @default(draft)
  scheduledFor DateTime?
  publishedAt  DateTime?
  expiresAt    DateTime?
  archivedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author        User                     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  audienceRules AnnouncementAudienceRule[]
  recipients    AnnouncementRecipient[]
  auditEvents   AnnouncementAuditEvent[]

  @@index([schoolId, status, createdAt])
  @@index([schoolId, scheduledFor])
  @@index([schoolId, expiresAt])
  @@index([schoolId, authorId, createdAt])
  @@index([status, scheduledFor], map: "announcements_status_scheduled_for_idx")
  @@index([status, expiresAt], map: "announcements_status_expires_at_idx")
  @@map("announcements")
}

/// One row per audience predicate selected by the author. A rule can target
/// the whole tenant, a role, a normalized class, or a normalized section.
model AnnouncementAudienceRule {
  id             String                   @id @default(uuid()) @db.Uuid
  announcementId String                   @db.Uuid
  type           AnnouncementAudienceType
  role           UserRole?
  classId        String?                  @db.Uuid
  sectionId      String?                  @db.Uuid
  createdAt      DateTime                 @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: Restrict)
  section      Section?     @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@index([announcementId])
  @@index([classId])
  @@index([sectionId])
  @@map("announcement_audience_rules")
}

/// Immutable publication snapshot. A null readAt represents an unread
/// announcement for that recipient.
model AnnouncementRecipient {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @db.Uuid
  userId         String   @db.Uuid
  schoolId       String   @db.Uuid
  deliveredAt    DateTime @default(now())
  readAt         DateTime?
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementRecipientUser", fields: [userId], references: [id], onDelete: Restrict)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId], map: "announcement_recipients_announcement_user_key")
  @@index([schoolId, userId, readAt], map: "announcement_recipients_inbox_idx")
  @@index([announcementId, readAt], map: "announcement_recipients_read_idx")
  @@map("announcement_recipients")
}

model AnnouncementAuditEvent {
  id             String                   @id @default(uuid()) @db.Uuid
  announcementId String                   @db.Uuid
  actorId        String?                  @db.Uuid
  schoolId       String                   @db.Uuid
  action         AnnouncementAuditAction
  metadata       Json?
  createdAt      DateTime                 @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AnnouncementAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([announcementId, createdAt])
  @@index([schoolId, createdAt])
  @@map("announcement_audit_events")
}
