generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}
enum UserRole {
  super_admin
  admin
  teacher
  student
  parent
  department_head
  accountant
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users            User[]
  classes          Class[]
  teacherProfiles  TeacherProfile[]
  departments      Department[]
  parentStudentLinks ParentStudent[]

  @@index([isActive])
  @@map("schools")
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  schoolId            String?         @db.Uuid
  firstName           String
  lastName            String
  email               String          @unique
  passwordHash        String
  role                UserRole
  phone               String?
  isActive            Boolean         @default(true)
  isEmailVerified     Boolean         @default(false)
  lastLogin           DateTime?
  passwordChangedAt   DateTime?
  refreshTokenVersion Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  school              School?         @relation(fields: [schoolId], references: [id])
  teacherProfile      TeacherProfile?
  studentProfile      StudentProfile?
  parentStudentLinks  ParentStudent[] @relation("ParentStudentParent")
  homeroomClasses     Class[]         @relation("HomeroomTeacher")
  departmentHeads     Department[]    @relation("DepartmentHead")

  @@index([schoolId])
  @@index([schoolId, role])
  @@index([schoolId, role, createdAt])
  @@index([role])
  @@index([createdAt])
  @@index([role], map: "idx_users_role")
  @@index([schoolId], map: "idx_users_school_id")
  @@index([firstName(ops: raw("gin_trgm_ops"))], map: "users_first_name_trgm_idx", type: Gin)
  @@index([lastName(ops: raw("gin_trgm_ops"))], map: "users_last_name_trgm_idx", type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], map: "users_email_trgm_idx", type: Gin)
  @@map("users")
}

model TeacherProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId        String   @db.Uuid
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  departmentId    String?  @db.Uuid
  department      Department? @relation("DepartmentTeacherProfiles", fields: [departmentId], references: [id], onDelete: SetNull)
  hireDate        DateTime?
  qualifications  String?
  employeeId      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, employeeId])
  @@index([schoolId])
  @@index([employeeId(ops: raw("gin_trgm_ops"))], map: "teacher_profiles_employee_trgm_idx", type: Gin)
  @@map("teacher_profiles")
}

model Department {
  id            String   @id @default(uuid()) @db.Uuid
  schoolId      String   @db.Uuid
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name          String
  code          String
  description   String?
  icon          String?
  isActive      Boolean  @default(true)

  headTeacherId String?  @db.Uuid
  headTeacher   User?    @relation("DepartmentHead", fields: [headTeacherId], references: [id], onDelete: SetNull)

  teacherProfiles TeacherProfile[] @relation("DepartmentTeacherProfiles")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("departments")
}

model StudentProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  admissionNo     String?  @unique
  dateOfBirth     DateTime?
  gender          String?
  enrollmentDate  DateTime?

  classId         String?  @db.Uuid
  class           Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)

  previousSchool  String?
  medicalNotes    String?
  address         String?
  guardianName    String?
  guardianPhone   String?
  guardianEmail   String?

  parentLinks     ParentStudent[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([classId])
  @@index([admissionNo(ops: raw("gin_trgm_ops"))], map: "student_profiles_admission_trgm_idx", type: Gin)
  @@map("student_profiles")
}

model ParentStudent {
  schoolId         String         @db.Uuid
  parentId         String         @db.Uuid
  studentProfileId String         @db.Uuid
  relationship     String         @default("guardian")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parent           User           @relation("ParentStudentParent", fields: [parentId], references: [id], onDelete: Cascade)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@id([schoolId, parentId, studentProfileId])
  @@index([schoolId, parentId])
  @@index([schoolId, studentProfileId])
  @@map("parent_students")
}


model Class {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @db.Uuid
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name         String                          // "Grade 10A"
  grade        String                          // "10"
  section      String                          // "A"
  academicYear String                          // "2026-2027"
  capacity     Int?                            // optional max students

  homeroomTeacherId String?  @db.Uuid
  homeroomTeacher   User?    @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)

  students     StudentProfile[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schoolId, grade, section, academicYear])
  @@index([schoolId])
  @@index([homeroomTeacherId])
  @@map("classes")
}
